# Copy to ci/.env and fill in. ci/.env is gitignored; this template is not.

# Password and schema for the PostgreSQL service. The API runs on Npgsql.
POSTGRES_PWD=change-me
POSTGRES_DB=plants

# Npgsql connection string. Inside compose the host is the service name `db`, not
# localhost. From `dotnet run` on your machine it is localhost:5432, and that one
# lives in user-secrets rather than here.
CONNECTION_STRING=Host=db;Port=5432;Database=plants;Username=postgres;Password=change-me

# Only read by docker-compose.prod.yml; the dev file pins Development.
ASPNETCORE_ENVIRONMENT=Production
